#!/bin/sh
# mahler-launcher — the stable entry point launchd runs every 60s (DESIGN D17).
#
# Deliberately tiny, and installed by *copying* it to ~/.mahler/bin: the code it
# runs (~/.mahler/app) updates itself, this script never does. Edit it by hand,
# then re-run launcher/install.sh.
#
#   1. run one tick from the pinned app clone
#   2. clean tick  -> that commit becomes known-good
#      2 bad ticks -> roll back to known-good and ping
#      exit 3 -> immediately roll back to the last successful launch
#   3. advance to origin/main only if CI on that commit is green and the unit
#      tests pass here; otherwise stay put
set -u
M="${MAHLER_HOME:-$HOME/.mahler}"
APP="$M/app"
LOG="$M/logs"
mkdir -p "$LOG"
head=unknown
new=unknown
# Fixed tokens and Git object IDs only: never log command output or credentials.
decision() {
  printf '%s head=%s candidate=%s outcome=%s reason=%s\n' \
    "$(date -u +%FT%TZ)" "$head" "$new" "$1" "$2" >> "$LOG/update.log"
}
stop_update() {
  decision "$1" "$2"
  exit 0
}
cd "$APP" 2>/dev/null || { decision blocked app_unavailable; exit 1; }

# keep the tick log from growing forever
if [ -f "$LOG/tick.log" ] && [ "$(wc -c < "$LOG/tick.log")" -gt 5000000 ]; then
  mv "$LOG/tick.log" "$LOG/tick.log.1"
fi

{ echo "--- $(date '+%F %T')"; "$APP/bin/mahler" tick; } >> "$LOG/tick.log" 2>&1
rc=$?
head=$(git -C "$APP" rev-parse --verify HEAD 2>/dev/null) || { head=unknown; stop_update blocked head_lookup_failed; }

if [ "$rc" -eq 0 ]; then
  echo "$head" > "$M/known_good"
  echo 0 > "$M/tick_failures"
else
  n=$(( $(cat "$M/tick_failures" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$M/tick_failures"
  good=$(cat "$M/known_good" 2>/dev/null || true)
  if [ "$rc" -eq 3 ]; then
    good=$(cat "$M/launch_ok" 2>/dev/null || true)
    n=2
  fi
  if [ "$n" -ge 2 ] && [ -n "$good" ] && [ "$head" != "$good" ]; then
    git -C "$APP" checkout -q --detach "$good" 2>/dev/null || stop_update blocked rollback_checkout_failed
    echo "$head" > "$M/bad_sha"
    echo 0 > "$M/tick_failures"
    decision rolled_back tick_failed
    if [ "$rc" -eq 3 ]; then
      "$APP/bin/mahler" notify "Mahler rolled back: launches were failing on $head" \
        "Back on $good." >/dev/null 2>&1
    else
      "$APP/bin/mahler" notify "Mahler rolled itself back" \
        "Two ticks failed on $(echo "$head" | cut -c1-7); back on $(echo "$good" | cut -c1-7)." \
        >/dev/null 2>&1
    fi
  else
    decision blocked tick_failed
  fi
  exit 0
fi

# Explicit destination avoids a stale origin/main when remote.origin.fetch is
# missing or maps only another branch.
git -C "$APP" fetch -q origin +refs/heads/main:refs/remotes/origin/main 2>/dev/null || stop_update blocked fetch_failed
new=$(git -C "$APP" rev-parse --verify refs/remotes/origin/main^{commit} 2>/dev/null) || { new=unknown; stop_update blocked candidate_lookup_failed; }
[ "$new" = "$head" ] && stop_update unchanged already_current
[ "$new" = "$(cat "$M/bad_sha" 2>/dev/null || true)" ] && stop_update blocked rollback_excluded
repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null) || stop_update blocked repository_lookup_failed
[ -n "$repo" ] || stop_update blocked repository_lookup_empty
ci=$(gh api "repos/$repo/commits/$new/check-runs" --jq '
  [.check_runs[].conclusion] |
  if length == 0 then "none"
  elif all(. == "success" or . == "skipped" or . == "neutral") then "green"
  else "wait" end' 2>/dev/null) || stop_update blocked checks_lookup_failed
case "$ci" in
  green) ;;
  none) stop_update blocked checks_missing ;;
  wait) stop_update blocked checks_not_green ;;
  *) stop_update blocked checks_result_invalid ;;
esac
git -C "$APP" checkout -q --detach "$new" 2>/dev/null || stop_update blocked candidate_checkout_failed
# Do not mix arbitrary test output (which may contain credentials) into decisions.
if python3 -m unittest discover -s "$APP/tests" >/dev/null 2>&1; then
  decision updated ci_and_tests_passed
else
  git -C "$APP" checkout -q --detach "$head" 2>/dev/null || stop_update blocked tests_failed_restore_failed
  decision rejected tests_failed
fi
exit 0
